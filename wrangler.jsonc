{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edu-signal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d74918b8c599498093875a5ae9fd3356"
    }
  ],
  "observability": {
    "enabled": true
  }
}
