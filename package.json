{
  "name": "edu-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/m1-identity.test.mjs tests/m2-m4-activity.test.mjs tests/m5-evidence.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:m4": "tsx scripts/seed-m4.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "auth:seed": "tsx scripts/seed-auth.ts",
    "test:m1": "node --test tests/m1-identity.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && node --test tests/rendered-html.test.mjs tests/m1-identity.test.mjs tests/m2-m4-activity.test.mjs tests/m5-evidence.test.mjs && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  },
  "type": "module"
}
