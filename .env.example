# Public Supabase project settings. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only settings. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# AI features are disabled by default. Configure these as server-only Worker
# secrets/variables; never prefix them with NEXT_PUBLIC_.
AI_CURRICULUM_ENABLED=false
DEEP_LEARNING_LOOP_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_REQUEST_TIMEOUT_MS=45000
AI_GENERATION_MAX_OUTPUT_TOKENS=12000
AI_FEEDBACK_MAX_OUTPUT_TOKENS=3000
AI_TEACHER_DAILY_TOKEN_LIMIT=250000
AI_STUDENT_DAILY_TOKEN_LIMIT=50000
AI_PSEUDONYM_SALT=

# Cloudflare uses the HYPERDRIVE binding in wrangler.jsonc. DATABASE_URL remains
# the local Node.js/Postgres fallback and is never exposed to the browser.

# Optional development-only live verification inputs. Never commit values.
M4_APP_URL=
M4_STUDENT_A_EMAIL=
M4_STUDENT_A_PASSWORD=
M4_STUDENT_B_EMAIL=
M4_STUDENT_B_PASSWORD=
M4_TEACHER_EMAIL=
M4_TEACHER_PASSWORD=
