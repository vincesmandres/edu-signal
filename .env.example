# Public Supabase project settings. Safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only settings. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=

# No Cloudflare runtime variables are required by Next.js/Vercel.

# Optional development-only live verification inputs. Never commit values.
M4_APP_URL=
M4_STUDENT_A_EMAIL=
M4_STUDENT_A_PASSWORD=
M4_STUDENT_B_EMAIL=
M4_STUDENT_B_PASSWORD=
M4_TEACHER_EMAIL=
M4_TEACHER_PASSWORD=
